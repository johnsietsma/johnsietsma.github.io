---
import { getCollection } from "astro:content";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Selected projects and work.",
	title: "Projects",
};

const entries = await getCollection("portfolio");
entries.sort((a, b) => String(b.data.date ?? "").localeCompare(String(a.data.date ?? "")));
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">Projects</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<ul>
			{
				entries.map((e) => (
					<li>
						<a class="cactus-link" href={"/portfolio/" + e.id + "/"}>
							{e.data.title}
						</a>
						{e.data.position && <span> &mdash; {e.data.position}</span>}
					</li>
				))
			}
		</ul>
	</div>
</PageLayout>
