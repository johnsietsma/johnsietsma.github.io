---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const entries = await getCollection("portfolio");
entries.sort((a, b) => String(b.data.date ?? "").localeCompare(String(a.data.date ?? "")));
---

<Layout title={`Projects | ${config.site.title}`} description="Selected projects and work.">
  <Header />
  <Breadcrumb />
  <Main pageTitle="Projects" class="app-prose">
    <ul>
      {
        entries.map(e => (
          <li>
            <a href={`/portfolio/${e.id}/`}>{e.data.title}</a>
            {e.data.position && <span> &mdash; {e.data.position}</span>}
          </li>
        ))
      }
    </ul>
  </Main>
  <Footer />
</Layout>
